# Neon Postgres
# Pooled (-pooler host) as the least-privilege `app_user` role (security C2):
# used by the app via @prisma/adapter-neon. Set BY HAND: `neon env pull` and
# `neon deploy` would write the owner role here. Use `neon deploy --no-env-pull`
# and `neon env pull -e DATABASE_URL_UNPOOLED -e NEON_BRANCH` to keep it.
DATABASE_URL=""
# Direct/unpooled as the owner role: used by the Prisma CLI (migrate, studio)
DATABASE_URL_UNPOOLED=""
NEON_BRANCH="production"

# Better Auth (self-hosted) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

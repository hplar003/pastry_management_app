# Neon Postgres — written by `neon link` / `neon deploy` / `neon env pull`
# Pooled (-pooler host): used by the app via @prisma/adapter-neon
DATABASE_URL=""
# Direct/unpooled: used by the Prisma CLI (migrate, studio)
DATABASE_URL_UNPOOLED=""
NEON_BRANCH="production"

# Better Auth (self-hosted) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
